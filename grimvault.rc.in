// Shell-facing exe resources, configured by CMake (edit grimvault.rc.in,
// not the generated grimvault.rc).
//
// The icon is what Explorer / taskbar / Task Manager render for the exe;
// VERSIONINFO's FileDescription is the display name Task Manager shows for
// background processes — without it the lowercase filename leaks through.

IDI_ICON1 ICON "@GRIMVAULT_ICON_ICO@"

1 VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
   BLOCK "StringFileInfo"
   BEGIN
      BLOCK "040904b0"
      BEGIN
         VALUE "CompanyName",      "DarkerDB"
         VALUE "FileDescription",  "GrimVault"
         VALUE "FileVersion",      "@GRIMVAULT_DISPLAY_VERSION@"
         VALUE "InternalName",     "GrimVault"
         VALUE "LegalCopyright",   "Copyright (c) DarkerDB"
         VALUE "OriginalFilename", "grimvault.exe"
         VALUE "ProductName",      "GrimVault"
         VALUE "ProductVersion",   "@GRIMVAULT_DISPLAY_VERSION@"
      END
   END
   BLOCK "VarFileInfo"
   BEGIN
      VALUE "Translation", 0x409, 1200
   END
END
